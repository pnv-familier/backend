            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Jane Doe\",\n  \"email\": \"jane.doe@example.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login User B",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set(\"accessTokenB\", jsonData.data.accessToken);",
                  "    pm.test(\"User B Token stored successfully\", function () {",
                  "        pm.expect(jsonData.data.accessToken).to.be.a('string');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane.doe@example.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Update User B Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessTokenB}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dateOfBirth\": \"1992-05-15\",\n  \"gender\": \"FEMALE\",\n  \"hobbies\": [\"Painting\", \"Running\", \"Cooking\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "profile"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Join Family",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessTokenB}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"joinCode\": \"{{familyInviteCode}}\",\n  \"relationship\": \"SPOUSE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/families/join",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "families",
                "join"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Verification & AI Testing",
      "item": [
        {
          "name": "Get Family Details (User A)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessTokenA}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/families/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "families",
                "me"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Family Members (User A)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessTokenA}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/families/members",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "families",
                "members"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Stream AI Chat (Ask about Spouse)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessTokenA}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ai/chat?message=Vợ mình tên là gì và cô ấy có những sở thích nào vậy?",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ai",
                "chat"
              ],
              "query": [
                {
                  "key": "message",
                  "value": "Vợ mình tên là gì và cô ấy có những sở thích nào vậy?"
                }
              ]
            },
            "description": "Queries the AI assistant. Since User A and User B are connected via SPOUSE relationship, the AI parses the query, matches the mention of 'Vợ' (Spouse) to Jane's profile using the RelationshipMappingService, pulls Jane's hobbies, and streams a personalized answer."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "accessTokenA",
      "value": "",
      "type": "string"
    },
    {
      "key": "accessTokenB",
      "value": "",
      "type": "string"
    },
    {
      "key": "familyInviteCode",
